{
  "type": "page",
  "title": "➕ 新增商品",
  "toolbar": [
    {
      "type": "button",
      "label": "← 返回列表",
      "level": "default",
      "actionType": "url",
      "url": "./pc.html?page=goods-list"
    }
  ],
  "body": [
    {
      "type": "form",
      "mode": "horizontal",
      "api": {
        "method": "post",
        "url": "/api/goods/add"
      },
      "messages": {
        "saveSuccess": "新增成功！"
      },
      "body": [
        {
          "type": "input-text",
          "name": "barcode",
          "label": "条形码",
          "required": true,
          "placeholder": "扫码枪录入或手动输入",
          "addOn": {
            "type": "button",
            "label": "模拟扫码",
            "level": "info",
            "onClick": "this.setValueByName('barcode', '690123456789' + Math.floor(Math.random() * 100));"
          }
        },
        {
          "type": "input-text",
          "name": "name",
          "label": "商品名称",
          "required": true,
          "placeholder": "请输入商品名称"
        },
        {
          "type": "input-number",
          "name": "wholesalePrice",
          "label": "批发价（元）",
          "required": true,
          "min": 0,
          "step": 0.01,
          "placeholder": "0.00"
        },
        {
          "type": "input-number",
          "name": "retailPrice",
          "label": "零售价（元）",
          "required": true,
          "min": 0,
          "step": 0.01,
          "placeholder": "0.00"
        },
        {
          "type": "select",
          "name": "factory",
          "label": "商品厂商",
          "required": true,
          "placeholder": "请选择厂商"
        },
        {
          "type": "submit",
          "label": "保存",
          "level": "primary"
        }
      ]
    }
  ]
}