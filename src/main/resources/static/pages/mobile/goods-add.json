{
  "type": "page",
  "title": "➕ 新增商品",
  "body": [
    {
      "type": "form",
      "mode": "horizontal",
      "api": {
        "method": "post",
        "url": "/api/goods/add"
      },
      "messages": {
        "saveSuccess": "新增成功！"
      },
      "body": [
        {
          "type": "input-group",
          "label": "条形码",
          "body": [
            {
              "type": "input-text",
              "name": "barcode",
              "placeholder": "扫码或手动输入",
              "required": true,
              "size": "lg",
              "clearable": true
            },
            {
              "type": "button",
              "label": "📷",
              "level": "info",
              "onClick": "window.openCamera()"
            }
          ]
        },
        {
          "type": "input-text",
          "name": "name",
          "label": "商品名称",
          "required": true,
          "placeholder": "请输入商品名称",
          "size": "lg"
        },
        {
          "type": "input-number",
          "name": "wholesalePrice",
          "label": "批发价（元）",
          "required": true,
          "min": 0,
          "step": 0.01,
          "placeholder": "0.00",
          "size": "lg"
        },
        {
          "type": "input-number",
          "name": "retailPrice",
          "label": "零售价（元）",
          "required": true,
          "min": 0,
          "step": 0.01,
          "placeholder": "0.00",
          "size": "lg"
        },
        {
          "type": "select",
          "name": "factory",
          "label": "商品厂商",
          "required": true,
          "placeholder": "请选择厂商",
          "size": "lg"
        },
        {
          "type": "submit",
          "label": "保存",
          "level": "primary",
          "block": true,
          "size": "lg"
        }
      ]
    }
  ]
}