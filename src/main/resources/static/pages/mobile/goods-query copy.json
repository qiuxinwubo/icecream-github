{
  "type": "page",
  "title": "🔍 商品查询",
  "body": [
    {
      "type": "form",
      "mode": "horizontal",
      "wrapWithPanel": false,
      "body": [
        {
          "type": "input-group",
          "label": "",
          "body": [
            {
              "type": "input-text",
              "name": "barcode",
              "placeholder": "扫码或输入条形码",
              "size": "lg",
              "clearable": true
            },
            {
              "type": "button",
              "label": "📷 扫码",
              "level": "info",
              "onClick": "this.setValueByName('barcode', '690123456789' + Math.floor(Math.random() * 100));"
            }
          ]
        },
        {
          "type": "button",
          "label": "查 询",
          "level": "primary",
          "block": true,
          "actionType": "reload",
          "target": "queryService",
          "size": "lg"
        },
        {
          "type": "divider"
        },
        {
          "type": "service",
          "name": "queryService",
          "initFetch": false,
          "api": {
            "method": "get",
            "url": "/api/goods/query",
            "data": {
              "barcode": "${barcode}"
            },
            "adaptor": "if (payload.status === 404 || !payload.data) { return { data: null, msg: '未查询到该商品！' }; } return { data: payload.data, msg: 'ok' };"
          },
        "columns": [
            { "name": "name", "label": "商品名称" },
            { "name": "wholesalePrice", "label": "批发价", "tpl": "￥${wholesalePrice | number:2}" },
            { "name": "retailPrice", "label": "零售价", "tpl": "￥${retailPrice | number:2}" },
            { "name": "factory", "label": "厂商" },
            {
                "type": "operation",
                "label": "操作",
                "buttons": [
                {
                    "label": "编辑",
                    "level": "primary",
                    "actionType": "dialog",
                    "dialog": {
                    "title": "编辑商品",
                    "body": {
                        "type": "service",
                        "api": {
                        "method": "get",
                        "url": "/api/goods/query",
                        "data": { "barcode": "${barcode}" },
                        "adaptor": "if (payload.status === 404 || !payload.data) { return { data: null }; } return { data: payload.data };"
                        },
                        "body": [
                        {
                            "type": "form",
                            "mode": "horizontal",
                            "api": {
                            "method": "put",
                            "url": "/api/goods/update",
                            "data": {
                                "barcode": "${barcode}",
                                "name": "${name}",
                                "wholesalePrice": "${wholesalePrice}",
                                "retailPrice": "${retailPrice}",
                                "factory": "${factory}"
                            }
                            },
                            "data": "${data}",
                            "body": [
                            { "type": "input-text", "name": "barcode", "label": "条形码", "disabled": true, "static": true },
                            { "type": "input-text", "name": "name", "label": "商品名称", "required": true },
                            { "type": "input-number", "name": "wholesalePrice", "label": "批发价（元）", "required": true, "min": 0, "step": 0.01 },
                            { "type": "input-number", "name": "retailPrice", "label": "零售价（元）", "required": true, "min": 0, "step": 0.01 },
                            { "type": "select", "name": "factory", "label": "厂商", "required": true, "placeholder": "请选择厂商" },
                            { "type": "submit", "label": "保存修改", "level": "primary", "block": true }
                            ]
                        }
                        ]
                    }
                    }
                },
                {
                    "label": "删除",
                    "level": "danger",
                    "actionType": "ajax",
                    "confirmText": "确定删除？",
                    "api": {
                    "method": "delete",
                    "url": "/api/goods/delete",
                    "data": { "barcode": "${barcode}" }
                    },
                    "reload": "mobileGoodsCrud"
                }
                ]
            }
            ]
        }
      ]
    }
  ]
}