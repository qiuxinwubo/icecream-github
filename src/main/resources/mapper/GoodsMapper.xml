<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.icecream.mapper.GoodsMapper">

    <resultMap id="BaseResultMap" type="com.example.icecream.entity.Goods">
        <id column="id" property="id"/>
        <result column="barcode" property="barcode"/>
        <result column="name" property="name"/>
        <result column="wholesale_price" property="wholesalePrice"/>
        <result column="retail_price" property="retailPrice"/>
        <result column="vendor_id" property="vendorId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO goods(barcode, name, wholesale_price, retail_price, vendor_id)
        VALUES(#{barcode}, #{name}, #{wholesalePrice}, #{retailPrice}, #{vendorId})
    </insert>

    <update id="update">
        UPDATE goods SET
        name = #{name},
        wholesale_price = #{wholesalePrice},
        retail_price = #{retailPrice},
        vendor_id = #{vendorId},
        update_time = CURRENT_TIMESTAMP
        WHERE barcode = #{barcode}
    </update>

    <delete id="deleteByBarcode">
        DELETE FROM goods WHERE barcode = #{barcode}
    </delete>

    <select id="selectByBarcode" resultMap="BaseResultMap">
        SELECT * FROM goods WHERE barcode = #{barcode}
    </select>

    <select id="search" resultMap="BaseResultMap">
        SELECT * FROM goods
        <where>
            <if test="barcode != null and barcode != ''">
                AND barcode LIKE '%' || #{barcode} || '%'
            </if>
            <if test="name != null and name != ''">
                AND name LIKE '%' || #{name} || '%'
            </if>
            <if test="vendorId != null">
                AND vendor_id = #{vendorId}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM goods
        <where>
            <if test="barcode != null and barcode != ''">
                AND barcode LIKE '%' || #{barcode} || '%'
            </if>
            <if test="name != null and name != ''">
                AND name LIKE '%' || #{name} || '%'
            </if>
            <if test="vendorId != null">
                AND vendor_id = #{vendorId}
            </if>
        </where>
    </select>

    <select id="listAll" resultMap="BaseResultMap">
        SELECT * FROM goods ORDER BY id DESC
    </select>

</mapper>