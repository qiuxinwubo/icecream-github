<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.icecream.mapper.FactoryMapper">

    <resultMap id="BaseResultMap" type="com.example.icecream.entity.Factory">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO factory(name) VALUES(#{name})
    </insert>

    <update id="update">
        UPDATE factory SET name = #{name}, update_time = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM factory WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM factory WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="BaseResultMap">
        SELECT * FROM factory WHERE name = #{name}
    </select>

    <select id="listAll" resultMap="BaseResultMap">
        SELECT * FROM factory ORDER BY id DESC
    </select>

</mapper>